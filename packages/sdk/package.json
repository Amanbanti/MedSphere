{
  "name": "@medsphere/sdk",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./clients/auth": "./src/clients/auth.client.ts",
    "./clients/http": "./src/clients/http.client.ts"
  },
  "scripts": {
