// Phase 5 — Insurance & claims domain (production schema)

enum ClaimStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  PENDING
  PAID
  DENIED
  APPEALED
  CLOSED
}

enum EligibilityStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
  PENDING
}

enum AuthorizationStatus {
  PENDING
  APPROVED
  DENIED
  PARTIAL
  EXPIRED
  CANCELLED
}

enum CoverageLevel {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum DenialStatus {
  OPEN
  APPEALED
  OVERTURNED
  UPHELD
  CLOSED
}

enum AppealStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  WITHDRAWN
}

model Payer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  payerId        String    @map("payer_id") @db.VarChar(50)
  name           String    @db.VarChar(200)
  payerType      String    @map("payer_type") @db.VarChar(50)
  addressLine1   String?   @map("address_line1") @db.VarChar(200)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  postalCode     String?   @map("postal_code") @db.VarChar(20)
  phone          String?   @db.VarChar(20)
  electronicPayerId String? @map("electronic_payer_id") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  coverages           Coverage[]
  eligibilityChecks   EligibilityCheck[]
  priorAuthorizations PriorAuthorization[]
  claims              Claim[]
  remittanceAdvices   RemittanceAdvice[]

  @@unique([organizationId, payerId])
  @@index([organizationId, isActive])
  @@index([deletedAt])
  @@map("payers")
}

model Coverage {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  patientId        String        @map("patient_id") @db.Uuid
  payerId          String        @map("payer_id") @db.Uuid
  level            CoverageLevel @default(PRIMARY)
  memberId         String        @map("member_id") @db.VarChar(100)
  groupNumber      String?       @map("group_number") @db.VarChar(100)
  planName         String?       @map("plan_name") @db.VarChar(200)
  effectiveDate    DateTime      @map("effective_date") @db.Date
  terminationDate  DateTime?     @map("termination_date") @db.Date
  copayAmount      Decimal?      @map("copay_amount") @db.Decimal(14, 4)
  deductibleAmount Decimal?      @map("deductible_amount") @db.Decimal(14, 4)
  coinsurancePct   Decimal?      @map("coinsurance_pct") @db.Decimal(5, 2)
  isActive         Boolean       @default(true) @map("is_active")
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version          Int           @default(1)

  payer              Payer              @relation(fields: [payerId], references: [id])
  eligibilityChecks  EligibilityCheck[]
  priorAuthorizations PriorAuthorization[]
  claims             Claim[]

  @@index([organizationId, patientId])
  @@index([organizationId, payerId])
  @@index([deletedAt])
  @@map("coverages")
}

model EligibilityCheck {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  patientId        String            @map("patient_id") @db.Uuid
  payerId          String            @map("payer_id") @db.Uuid
  coverageId       String?           @map("coverage_id") @db.Uuid
  status           EligibilityStatus @default(PENDING)
  serviceTypeCodes String[]          @map("service_type_codes")
  requestPayload   Json              @map("request_payload") @default("{}")
  responsePayload  Json              @map("response_payload") @default("{}")
  traceNumber      String?           @map("trace_number") @db.VarChar(100)
  checkedAt        DateTime          @default(now()) @map("checked_at") @db.Timestamptz(6)
  effectiveDate    DateTime?         @map("effective_date") @db.Date
  expirationDate   DateTime?         @map("expiration_date") @db.Date
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  version          Int               @default(1)

  payer    Payer     @relation(fields: [payerId], references: [id])
  coverage Coverage? @relation(fields: [coverageId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, payerId])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("eligibility_checks")
}

model PriorAuthorization {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  patientId        String              @map("patient_id") @db.Uuid
  payerId          String              @map("payer_id") @db.Uuid
  coverageId       String?             @map("coverage_id") @db.Uuid
  authNumber       String?             @map("auth_number") @db.VarChar(100)
  status           AuthorizationStatus @default(PENDING)
  serviceCodes     String[]            @map("service_codes")
  requestedUnits   Int?                @map("requested_units")
  approvedUnits    Int?                @map("approved_units")
  requestedAt      DateTime            @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz(6)
  expiresAt        DateTime?           @map("expires_at") @db.Timestamptz(6)
  denialReason     String?             @map("denial_reason") @db.VarChar(500)
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)
  version          Int                 @default(1)

  payer    Payer     @relation(fields: [payerId], references: [id])
  coverage Coverage? @relation(fields: [coverageId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("prior_authorizations")
}

model Claim {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  payerId          String      @map("payer_id") @db.Uuid
  coverageId       String?     @map("coverage_id") @db.Uuid
  encounterId      String?     @map("encounter_id") @db.Uuid
  claimNumber      String      @map("claim_number") @db.VarChar(50)
  status           ClaimStatus @default(DRAFT)
  totalBilled      Decimal     @map("total_billed") @db.Decimal(14, 4)
  totalAllowed     Decimal?    @map("total_allowed") @db.Decimal(14, 4)
  totalPaid        Decimal?    @map("total_paid") @db.Decimal(14, 4)
  patientResponsibility Decimal? @map("patient_responsibility") @db.Decimal(14, 4)
  serviceFrom      DateTime    @map("service_from") @db.Date
  serviceTo        DateTime    @map("service_to") @db.Date
  submittedAt      DateTime?   @map("submitted_at") @db.Timestamptz(6)
  adjudicatedAt    DateTime?   @map("adjudicated_at") @db.Timestamptz(6)
  metadata         Json        @default("{}")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?     @map("created_by") @db.Uuid
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?     @map("updated_by") @db.Uuid
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)
  deletedBy        String?     @map("deleted_by") @db.Uuid
  version          Int         @default(1)

  payer           Payer                @relation(fields: [payerId], references: [id])
  coverage        Coverage?            @relation(fields: [coverageId], references: [id])
  lines           ClaimLine[]
  statusHistory   ClaimStatusHistory[]
  attachments     ClaimAttachment[]
  denials         Denial[]
  appeals         Appeal[]
  remittanceAdvices RemittanceAdvice[]

  @@unique([organizationId, claimNumber])
  @@index([organizationId, status])
  @@index([organizationId, patientId])
  @@index([deletedAt])
  @@map("claims")
}

model ClaimLine {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  claimId        String    @map("claim_id") @db.Uuid
  lineNumber     Int       @map("line_number")
  procedureCode  String    @map("procedure_code") @db.VarChar(20)
  modifierCodes  String[]  @map("modifier_codes")
  diagnosisPointers Int[]  @map("diagnosis_pointers")
  quantity       Decimal   @default(1) @db.Decimal(10, 4)
  billedAmount   Decimal   @map("billed_amount") @db.Decimal(14, 4)
  allowedAmount  Decimal?  @map("allowed_amount") @db.Decimal(14, 4)
  paidAmount     Decimal?  @map("paid_amount") @db.Decimal(14, 4)
  serviceDate    DateTime  @map("service_date") @db.Date
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  claim Claim @relation(fields: [claimId], references: [id])

  @@index([organizationId, claimId])
  @@index([deletedAt])
  @@map("claim_lines")
}

model ClaimStatusHistory {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  claimId        String      @map("claim_id") @db.Uuid
  fromStatus     ClaimStatus? @map("from_status")
  toStatus       ClaimStatus @map("to_status")
  reason         String?     @db.VarChar(500)
  changedBy      String?     @map("changed_by") @db.Uuid
  changedAt      DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  version        Int         @default(1)

  claim Claim @relation(fields: [claimId], references: [id])

  @@index([organizationId, claimId])
  @@index([claimId, changedAt])
  @@map("claim_status_histories")
}

model ClaimAttachment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  claimId        String    @map("claim_id") @db.Uuid
  fileName       String    @map("file_name") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  storageKey     String    @map("storage_key") @db.VarChar(500)
  fileSizeBytes  Int       @map("file_size_bytes")
  uploadedAt     DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy     String?   @map("uploaded_by") @db.Uuid
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  claim Claim @relation(fields: [claimId], references: [id])

  @@index([organizationId, claimId])
  @@index([deletedAt])
  @@map("claim_attachments")
}

model RemittanceAdvice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  payerId        String    @map("payer_id") @db.Uuid
  claimId        String?   @map("claim_id") @db.Uuid
  eraNumber      String    @map("era_number") @db.VarChar(50)
  checkNumber    String?   @map("check_number") @db.VarChar(50)
  paymentAmount  Decimal   @map("payment_amount") @db.Decimal(14, 4)
  postedAmount   Decimal   @default(0) @map("posted_amount") @db.Decimal(14, 4)
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  rawPayload     Json      @map("raw_payload") @default("{}")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  payer Payer  @relation(fields: [payerId], references: [id])
  claim Claim? @relation(fields: [claimId], references: [id])

  @@unique([organizationId, eraNumber])
  @@index([organizationId, payerId])
  @@index([deletedAt])
  @@map("remittance_advices")
}

model Denial {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  claimId        String       @map("claim_id") @db.Uuid
  denialCode     String       @map("denial_code") @db.VarChar(20)
  denialReason   String       @map("denial_reason") @db.VarChar(500)
  deniedAmount   Decimal      @map("denied_amount") @db.Decimal(14, 4)
  status         DenialStatus @default(OPEN)
  deniedAt       DateTime     @default(now()) @map("denied_at") @db.Timestamptz(6)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  version        Int          @default(1)

  claim   Claim    @relation(fields: [claimId], references: [id])
  appeals Appeal[]

  @@index([organizationId, claimId])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("denials")
}

model Appeal {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  claimId        String       @map("claim_id") @db.Uuid
  denialId       String?      @map("denial_id") @db.Uuid
  appealNumber   String       @map("appeal_number") @db.VarChar(50)
  status         AppealStatus @default(DRAFT)
  appealLevel    Int          @default(1) @map("appeal_level")
  requestedAmount Decimal     @map("requested_amount") @db.Decimal(14, 4)
  recoveredAmount Decimal?    @map("recovered_amount") @db.Decimal(14, 4)
  submittedAt    DateTime?    @map("submitted_at") @db.Timestamptz(6)
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)
  notes          String?      @db.VarChar(2000)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  version        Int          @default(1)

  claim  Claim   @relation(fields: [claimId], references: [id])
  denial Denial? @relation(fields: [denialId], references: [id])

  @@unique([organizationId, appealNumber])
  @@index([organizationId, claimId])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("appeals")
}
