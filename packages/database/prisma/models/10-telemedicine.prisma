// Phase 7 — Telemedicine & video consultation (production schema)

enum VideoSessionStatus {
  SCHEDULED
  WAITING
  LIVE
  ENDED
  CANCELLED
  FAILED
}

enum ParticipantRole {
  PATIENT
  PROVIDER
  NURSE
  INTERPRETER
  OBSERVER
  CAREGIVER
}

enum RecordingStatus {
  NOT_RECORDED
  RECORDING
  PROCESSING
  AVAILABLE
  DELETED
  FAILED
}

enum WaitingRoomStatus {
  QUEUED
  ADMITTED
  LEFT
  EXPIRED
}

model VideoSession {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  patientId        String             @map("patient_id") @db.Uuid
  providerId       String             @map("provider_id") @db.Uuid
  appointmentId    String?            @map("appointment_id") @db.Uuid
  encounterId      String?            @map("encounter_id") @db.Uuid
  roomId           String             @map("room_id") @db.VarChar(100)
  status           VideoSessionStatus @default(SCHEDULED)
  scheduledStartAt DateTime           @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt   DateTime?          @map("scheduled_end_at") @db.Timestamptz(6)
  startedAt        DateTime?          @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime?          @map("ended_at") @db.Timestamptz(6)
  durationSeconds  Int?               @map("duration_seconds")
  signalingToken   String?            @map("signaling_token") @db.VarChar(500)
  metadata         Json               @default("{}")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?            @map("created_by") @db.Uuid
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?            @map("updated_by") @db.Uuid
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy        String?            @map("deleted_by") @db.Uuid
  version          Int                @default(1)

  participants     SessionParticipant[]
  waitingRoomEntries WaitingRoomEntry[]
  chatMessages     SessionChatMessage[]
  sharedFiles      SharedFile[]
  screenShareEvents ScreenShareEvent[]
  consultationNotes ConsultationNote[]
  recordingMetadata RecordingMetadata[]
  iceCandidates    SignalingIceCandidate[]

  @@unique([organizationId, roomId])
  @@index([organizationId, status])
  @@index([organizationId, patientId])
  @@index([organizationId, providerId])
  @@index([deletedAt])
  @@map("video_sessions")
}

model SessionParticipant {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           ParticipantRole
  displayName    String          @map("display_name") @db.VarChar(200)
  joinedAt       DateTime?       @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?       @map("left_at") @db.Timestamptz(6)
  isMuted        Boolean         @default(false) @map("is_muted")
  isVideoOff     Boolean         @default(false) @map("is_video_off")
  connectionId   String?         @map("connection_id") @db.VarChar(200)
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  version        Int             @default(1)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@index([sessionId, userId])
  @@index([deletedAt])
  @@map("session_participants")
}

model WaitingRoomEntry {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  sessionId      String            @map("session_id") @db.Uuid
  patientId      String            @map("patient_id") @db.Uuid
  status         WaitingRoomStatus @default(QUEUED)
  queuePosition  Int               @map("queue_position")
  joinedAt       DateTime          @default(now()) @map("joined_at") @db.Timestamptz(6)
  admittedAt     DateTime?         @map("admitted_at") @db.Timestamptz(6)
  leftAt         DateTime?         @map("left_at") @db.Timestamptz(6)
  deviceInfo     Json              @default("{}") @map("device_info")
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)
  version        Int               @default(1)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@index([sessionId, status])
  @@index([deletedAt])
  @@map("waiting_room_entries")
}

model SessionChatMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  senderRole     ParticipantRole @map("sender_role")
  messageType    String    @default("TEXT") @map("message_type") @db.VarChar(20)
  content        String    @db.VarChar(4000)
  sentAt         DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@index([sessionId, sentAt])
  @@index([deletedAt])
  @@map("session_chat_messages")
}

model SharedFile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  uploadedBy     String    @map("uploaded_by") @db.Uuid
  fileName       String    @map("file_name") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  storageKey     String    @map("storage_key") @db.VarChar(500)
  fileSizeBytes  Int       @map("file_size_bytes")
  sharedAt       DateTime  @default(now()) @map("shared_at") @db.Timestamptz(6)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@index([deletedAt])
  @@map("shared_files")
}

model ScreenShareEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  participantId  String    @map("participant_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  version        Int       @default(1)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@map("screen_share_events")
}

model ConsultationNote {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  noteType       String    @default("PROGRESS") @map("note_type") @db.VarChar(50)
  content        String    @db.Text
  signedAt       DateTime? @map("signed_at") @db.Timestamptz(6)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@index([deletedAt])
  @@map("consultation_notes")
}

model RecordingMetadata {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  status         RecordingStatus @default(NOT_RECORDED)
  storageKey     String?         @map("storage_key") @db.VarChar(500)
  durationSeconds Int?           @map("duration_seconds")
  fileSizeBytes  Int?            @map("file_size_bytes")
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz(6)
  consentRecorded Boolean        @default(false) @map("consent_recorded")
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  version        Int             @default(1)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("recording_metadata")
}

model SignalingIceCandidate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  participantId  String    @map("participant_id") @db.Uuid
  candidate      String    @db.Text
  sdpMid         String?   @map("sdp_mid") @db.VarChar(100)
  sdpMLineIndex  Int?      @map("sdp_mline_index")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  session VideoSession @relation(fields: [sessionId], references: [id])

  @@index([organizationId, sessionId])
  @@index([sessionId, participantId])
  @@index([expiresAt])
  @@map("signaling_ice_candidates")
}
