{
  "name": "@medsphere/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./reference": "./src/reference/index.ts",
    "./testing": "./src/testing/index.ts",
    "./cds": "./src/cds/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "scripts": {
