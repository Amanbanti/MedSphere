# MedSphere Environment Variables
# Copy to .env and fill in values. Never commit secrets.

NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://medsphere:medsphere@localhost:5432/medsphere?schema=public
DATABASE_POOL_SIZE=20

# MongoDB
MONGODB_URI=mongodb://medsphere:medsphere@localhost:27017/medsphere?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=medsphere
KAFKA_GROUP_ID=medsphere-consumers

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=medsphere

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=medsphere
MINIO_SECRET_KEY=medsphere_secret_change_me
MINIO_BUCKET=medsphere-documents
MINIO_USE_SSL=false

# Auth
JWT_SECRET=change_me_to_a_64_char_random_secret_in_production_environments_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
MFA_ISSUER=MedSphere

# API Gateway
API_GATEWAY_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=medsphere
PROMETHEUS_PORT=9464

# Feature flags
FEATURE_TELEMEDICINE=true
FEATURE_AI_DIAGNOSIS=true
FEATURE_DICOM_VIEWER=true
