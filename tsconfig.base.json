{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "@medsphere/database": ["packages/database/src"],
      "@medsphere/database/*": ["packages/database/src/*"],
      "@medsphere/ui": ["packages/ui/src"],
      "@medsphere/ui/*": ["packages/ui/src/*"],
      "@medsphere/shared": ["packages/shared/src"],
      "@medsphere/shared/*": ["packages/shared/src/*"],
      "@medsphere/config": ["packages/config/src"],
      "@medsphere/config/*": ["packages/config/src/*"],
      "@medsphere/logger": ["packages/logger/src"],
      "@medsphere/logger/*": ["packages/logger/src/*"],
      "@medsphere/sdk": ["packages/sdk/src"],
      "@medsphere/sdk/*": ["packages/sdk/src/*"],
      "@medsphere/auth-sdk": ["packages/auth-sdk/src"],
      "@medsphere/auth-sdk/*": ["packages/auth-sdk/src/*"],
      "@medsphere/monitoring-sdk": ["packages/monitoring-sdk/src"],
      "@medsphere/monitoring-sdk/*": ["packages/monitoring-sdk/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
